{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LVOVD Desktop Preview",
  "version": "3.0.0-alpha.1",
  "identifier": "com.landonrivers.lvovd.preview",
  "build": { "frontendDist": "../desktop/dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "create": false, "title": "LVOVD", "width": 1280, "height": 800, "minWidth": 640, "minHeight": 480, "url": "index.html", "devtools": false }],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src lvovd-media: http://lvovd-media.localhost; connect-src ipc: http://ipc.localhost lvovd-media: http://lvovd-media.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false,
    "windows": { "webviewInstallMode": { "type": "offlineInstaller" }, "nsis": { "installMode": "currentUser" } },
    "macOS": { "minimumSystemVersion": "13.5" },
    "linux": { "appimage": { "bundleMediaFramework": true } }
  }
}
